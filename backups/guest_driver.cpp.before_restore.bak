    return STATUS_SUCCESS;
}

static NTSTATUS
LmvGuestDeviceControl(_In_ PDEVICE_OBJECT DeviceObject, _Inout_ PIRP Irp)
{
    UNREFERENCED_PARAMETER(DeviceObject);
    
    PIO_STACK_LOCATION stack = IoGetCurrentIrpStackLocation(Irp);
    NTSTATUS status = STATUS_NOT_SUPPORTED;
    ULONG_PTR information = 0;
    
    ULONG ioControlCode = stack->Parameters.DeviceIoControl.IoControlCode;
    PVOID inputBuffer = Irp->AssociatedIrp.SystemBuffer;
    ULONG inputBufferLength = stack->Parameters.DeviceIoControl.InputBufferLength;
    PVOID outputBuffer = Irp->AssociatedIrp.SystemBuffer;
    ULONG outputBufferLength = stack->Parameters.DeviceIoControl.OutputBufferLength;
    
    switch (ioControlCode)
    {
        case IOCTL_LMV_SET_DEBUG_MODE:
        {
            // Set debug mode (Interactive or Transparent)
            if (inputBufferLength >= sizeof(ULONG))
            {
                ULONG mode = *(ULONG*)inputBuffer;
                
                // Validate mode
                if (mode == LMV_DEBUG_MODE_INTERACTIVE || mode == LMV_DEBUG_MODE_TRANSPARENT)
                {
                    InterlockedExchange((volatile LONG*)&g_KiSessionMode, mode);
                    
                    
                    // Notify Host driver to update SharedVpData->KiSessionMode via CPUID
                    LMV_CPUID_RESULT result = {};
                    LmvGuestCpuidCall(LmvCpuidCommandSyncKiSession, mode, &result);
                    
                    if (result.Status != LMV_CPUID_RESULT_SUCCESS)
                    {
                        DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_ERROR_LEVEL,
                                   "[LMvtdriverGuest] Failed to sync mode with Host, status=%u\n",
                                   result.Status);
                        status = STATUS_UNSUCCESSFUL;
                        break;
                    }
                    
                    DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_INFO_LEVEL,
                               "[LMvtdriverGuest] Debug mode set to %u (%s)\n",
                               mode,
                               mode == LMV_DEBUG_MODE_INTERACTIVE ? "Interactive" : "Transparent");
                    
                    status = STATUS_SUCCESS;
                    information = 0;
                }
                else
                {
                    status = STATUS_INVALID_PARAMETER;
                }
            }
            else
            {
                status = STATUS_BUFFER_TOO_SMALL;
            }
            break;
        }
        
        case IOCTL_LMV_QUERY_STATUS:
        {
            // Query current status (including current mode)
            if (outputBufferLength >= sizeof(ULONG) * 2)
            {
                ULONG* output = (ULONG*)outputBuffer;
                output[0] = 1;  // Version
                output[1] = g_KiSessionMode;  // Current mode
                
                status = STATUS_SUCCESS;
                information = sizeof(ULONG) * 2;
            }
            else
            {
                status = STATUS_BUFFER_TOO_SMALL;
            }
            break;
        }
        
        
        case IOCTL_LMV_GUEST_KI_SESSION:
        {
            // Handle KI session operations (START, STOP, QUERY, PREPARE_UNLOAD)
            if (inputBufferLength >= sizeof(LMV_GUEST_KI_SESSION) && 
                outputBufferLength >= sizeof(LMV_GUEST_KI_SESSION))
            {
                PLMV_GUEST_KI_SESSION session = (PLMV_GUEST_KI_SESSION)inputBuffer;
                
                // Validate structure
                if (session->Version != LMV_CPUID_PROTOCOL_VERSION || 
                    session->Size != sizeof(LMV_GUEST_KI_SESSION))
                {
                    status = STATUS_INVALID_PARAMETER;
                    break;
                }
                
                switch (session->Operation)
                {
                    case LMV_KI_SESSION_START:
                    {
                        // Start KI debugging session
                        PEPROCESS process = NULL;
                        NTSTATUS lookupStatus = PsLookupProcessByProcessId(
                            ULongToHandle(session->ProcessId), 
                            &process);
                        
                        if (!NT_SUCCESS(lookupStatus) || process == NULL)
                        {
                            DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_ERROR_LEVEL,
                                       "[LMvtdriverGuest] PsLookupProcessByProcessId failed for PID=%u, status=0x%08X\n",
                                       session->ProcessId, lookupStatus);
                            status = STATUS_INVALID_PARAMETER;
                            break;
                        }
                        
                        // Get Kernel CR3 from EPROCESS
                        PUCHAR processBytes = reinterpret_cast<PUCHAR>(process);
                        ULONGLONG kernelCr3 = *reinterpret_cast<volatile ULONGLONG*>(
                            processBytes + LMV_KPROCESS_DIRECTORY_TABLE_BASE_OFFSET) & LMV_PAGE_ADDRESS_MASK;
                        
                        // Get KiDispatchException address
                        LMV_GUEST_KI_PAGE_PREFLIGHT preflight = {};
                        preflight.Version = LMV_CPUID_PROTOCOL_VERSION;
                        preflight.Size = sizeof(preflight);
                        
                        NTSTATUS kiBoundsStatus = LmvGuestFindKiFunctionBounds(&preflight);
                        ULONGLONG kiAddress = 0;
                        
                        if (NT_SUCCESS(kiBoundsStatus) && preflight.RoutineAddress != 0)
                        {
                            kiAddress = preflight.RoutineAddress;
                        }
                        else
                        {
                            DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_WARNING_LEVEL,
                                       "[LMvtdriverGuest] Failed to find KiDispatchException, status=0x%08X\n",
                                       kiBoundsStatus);
                        }
                        
                        // Release process reference
                        ObDereferenceObject(process);
                        
                        // Validate that we have valid values
                        if (kernelCr3 == 0 || kiAddress == 0)
                        {
                            DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_ERROR_LEVEL,
                                       "[LMvtdriverGuest] Invalid session parameters: CR3=0x%llX KiAddr=0x%llX\n",
                                       kernelCr3, kiAddress);
                            status = STATUS_UNSUCCESSFUL;
                            break;
                        }
                        
                        // Notify Host driver via CPUID to enable DR3 session
                        LMV_CPUID_RESULT result = {};
                        LmvGuestCpuidCall(LmvCpuidCommandSyncKiSession, 1, &result);
                        
                        if (result.Status != LMV_CPUID_RESULT_SUCCESS)
                        {
                            DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_ERROR_LEVEL,
                                       "[LMvtdriverGuest] Failed to sync KI session with Host, CPUID status=%u\n",
                                       result.Status);
                            status = STATUS_UNSUCCESSFUL;
                            break;
                        }
                        
                        // Fill in session information
                        session->KernelCr3 = kernelCr3;
                        session->KiAddress = kiAddress;
                        session->ProcessorsSeen = 1;
                        session->ProcessorsExpected = 1;
                        session->Mode = g_KiSessionMode;
                        // ProcessId is already set by caller
                        
                        status = STATUS_SUCCESS;
                        information = sizeof(LMV_GUEST_KI_SESSION);
                        
                        DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_INFO_LEVEL,
                                   "[LMvtdriverGuest] KI session started: PID=%u CR3=0x%llX Ki=0x%llX Mode=%u\n",
                                   session->ProcessId, kernelCr3, kiAddress, session->Mode);
                        break;
                    }
                    case LMV_KI_SESSION_STOP:
                    {
                        // Stop KI debugging session
                        status = LmvGuestStopKiSession(session);
                        if (NT_SUCCESS(status))
                        {
                            information = sizeof(LMV_GUEST_KI_SESSION);
                            DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_INFO_LEVEL,
                                       "[LMvtdriverGuest] KI session stopped\n");
                        }
                        break;
                    }
                    
                    case LMV_KI_SESSION_QUERY:
                    {
                        // Query KI session status
                        session->Mode = g_KiSessionMode;
                        session->ProcessorsSeen = 1;
                        session->ProcessorsExpected = 1;
                        
                        status = STATUS_SUCCESS;
                        information = sizeof(LMV_GUEST_KI_SESSION);
                        break;
                    }
                    
                    case LMV_KI_SESSION_PREPARE_UNLOAD:
                    {
                        // Prepare for unload
                        status = STATUS_SUCCESS;
                        information = sizeof(LMV_GUEST_KI_SESSION);
                        DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_INFO_LEVEL,
                                   "[LMvtdriverGuest] KI session prepared for unload\n");
                        break;
                    }
                    
                    default:
                        status = STATUS_INVALID_PARAMETER;
                        break;
                }
            }
            else
            {
                status = STATUS_BUFFER_TOO_SMALL;
            }
            break;
        }
        default:
            status = STATUS_NOT_SUPPORTED;
            break;
    }
    
    Irp->IoStatus.Status = status;
    Irp->IoStatus.Information = information;
    IoCompleteRequest(Irp, IO_NO_INCREMENT);
    return status;
}

static VOID
LmvGuestUnload(_In_ PDRIVER_OBJECT DriverObject)
{
    UNREFERENCED_PARAMETER(DriverObject);
    LmvGuestStubReset();
    if (g_KernelProbeStage != 0 && !NT_SUCCESS(LmvGuestCleanupKernelProbe(nullptr)))
        DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_ERROR_LEVEL,
                   "[LMvtdriverGuest] kernel execution probe cleanup failed; revert VM snapshot.\n");
    if (g_ExecProbeMdl != nullptr)
    {
        LMV_GUEST_EXEC_PROBE probe = {};
        probe.Operation = LMV_EXEC_PROBE_DISARM;
        if (!NT_SUCCESS(LmvGuestRunExecProbe(&probe, TRUE)))
            DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_ERROR_LEVEL,
                       "[LMvtdriverGuest] execution probe disarm failed; revert VM snapshot.\n");
    }
    if (g_KiNxSiteBuffer != nullptr)
    {
        ExFreePoolWithTag(g_KiNxSiteBuffer, 'iSmL');
        g_KiNxSiteBuffer = nullptr;
    }
    ExAcquireFastMutex(&g_KiMirrorMutex);
    if (g_KiMirrorAllocation != nullptr)
    {
        LmvGuestReleaseMirrorStorage();
    }
    ExReleaseFastMutex(&g_KiMirrorMutex);
    IoDeleteSymbolicLink(&g_SymbolicLink);
    IoDeleteSymbolicLink(&g_DebugSymbolicLink);
    if (g_DeviceObject != nullptr)
    {
        IoDeleteDevice(g_DeviceObject);
        g_DeviceObject = nullptr;
    }
    if (g_KiGuestRetired)
    {
        LMV_CPUID_RESULT result = {};
        LmvGuestCpuidCall(LmvCpuidCommandReleaseKiGuest, 0, &result);
        if (result.Status != LMV_CPUID_RESULT_SUCCESS)
            DbgPrintEx(DPFLTR_IHVDRIVER_ID, DPFLTR_ERROR_LEVEL,
                "[LMvtdriverGuest] Host release failed; do not force unload Host.\n");
    }
}


