typedef struct _LMV_KI_INSPECT_STATE
{
    volatile LONG Valid;
    ULONG Status;
    ULONG Reason;
    ULONG ProcessId;
    ULONG ThreadId;
    ULONG ExceptionCode;
    ULONG FirstChance;
    ULONGLONG ExceptionAddress;
    ULONG FrameStatus;
    ULONG FrameReason;
    LMV_GUEST_KI_FRAME_SNAPSHOT Frame;
    ULONG EventStatus;
    ULONG EventSequence;
} LMV_KI_INSPECT_STATE;

